---
import { getCollection, getEntry } from 'astro:content';
import HeroOrbit, { type HeroOrbitItem } from '../components/HeroOrbit.astro';
import Timeline, { type TimelineItem } from '../components/Timeline';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');

const heroEntries = (await getCollection('hero')).sort((a, b) => a.data.order - b.data.order);
const heroItems: HeroOrbitItem[] = heroEntries.map(({ id, data }) => ({
  id,
  title: data.title,
  description: data.description,
  image: data.image,
  imageAlt: data.imageAlt,
  format: data.format,
}));
const timelineEntries = (await getCollection('timeline')).sort(
  (a, b) => a.data.order - b.data.order,
);
const timeline: TimelineItem[] = timelineEntries.map(({ id, data }) => ({
  id,
  period: data.period,
  title: data.title,
  summary: data.summary,
  category: data.category,
  image: data.image,
  imageAlt: data.imageAlt,
  href: data.project,
}));
const projects = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={site.displayName} description={home.data.description}>
  <HeroOrbit
    items={heroItems}
    leftLabel={site.displayName}
    centerLabel={home.data.heroGreeting ?? '大竹'}
    rightLabel={site.location}
  />

  <section class="timeline-section shell" id="timeline" aria-labelledby="timeline-title">
    <div class="section-heading">
      <p class="eyebrow">Selected chapters</p>
      <h2 id="timeline-title">The path so far</h2>
      <p>A mix of the personal and professional moments that connect the work.</p>
    </div>
    <Timeline items={timeline} client:visible />
  </section>

  <section class="selected-work shell" aria-labelledby="selected-work-title">
    <div class="section-heading section-heading-row">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="selected-work-title">A closer look</h2>
      </div>
      <a class="text-link" href="/work">
        All work <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="work-grid">
      {projects.map((project, index) => (
        <WorkCard project={project} index={index} />
      ))}
    </div>
  </section>
</BaseLayout>

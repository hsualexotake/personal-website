---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const currentIndex = projects.findIndex(({ id }) => id === project.id);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  image={project.data.cover}
>
  <article class="case-study">
    <header class="case-hero shell">
      <a class="back-link" href="/work">
        <span aria-hidden="true">←</span> All work
      </a>
      <p class="eyebrow">Case study · Demo content</p>
      <h1>{project.data.title}</h1>
      <p class="case-summary">{project.data.summary}</p>
      <dl class="case-meta">
        <div>
          <dt>Year</dt>
          <dd>{project.data.year}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        {project.data.links.length > 0 && (
          <div>
            <dt>Links</dt>
            <dd>
              {project.data.links.map(({ label, url }) => (
                <a href={url} target="_blank" rel="noreferrer">
                  {label}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </header>

    <div class="case-cover shell">
      {project.data.cover ? (
        <img src={project.data.cover} alt={project.data.coverAlt ?? ''} decoding="async" />
      ) : (
        <span aria-hidden="true">Project media placeholder</span>
      )}
    </div>

    <div class="case-body shell">
      <div class="case-body-label">
        <p class="eyebrow">Project notes</p>
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {nextProject && nextProject.id !== project.id && (
    <aside class="next-project shell" aria-label="Next project">
      <p class="eyebrow">Next project</p>
      <a href={`/work/${nextProject.id}`}>
        <span>{nextProject.data.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </aside>
  )}
</BaseLayout>

---
import { getCollection } from 'astro:content';
import WorkCard from '../../components/WorkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Work"
  description="Selected projects, experiments, and the thinking behind them."
>
  <header class="page-hero shell">
    <p class="eyebrow">Work · {String(projects.length).padStart(2, '0')} projects</p>
    <h1>Selected projects and the decisions behind them.</h1>
    <p class="page-hero-summary">
      A flexible home for case studies, experiments, and collaborations. Every entry below is
      placeholder content ready to be replaced in the CMS.
    </p>
  </header>

  <section class="work-index shell" aria-label="Projects">
    <div class="work-grid">
      {projects.map((project, index) => (
        <WorkCard project={project} index={index} />
      ))}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="not-found shell">
    <p class="eyebrow">404 · Wrong turn</p>
    <h1>This page isn’t part of the story.</h1>
    <a class="text-link" href="/">
      Return home <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('bside', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, number: index + 1, entries },
  }));
}

interface Props {
  entry: CollectionEntry<'bside'>;
  number: number;
  entries: CollectionEntry<'bside'>[];
}

const { entry, number, entries } = Astro.props;
const { Content } = await render(entry);
const currentIndex = entries.findIndex(({ id }) => id === entry.id);
const nextEntry = entries[(currentIndex + 1) % entries.length];
const displayNumber = String(number).padStart(2, '0');
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.image}>
  <article class="bside-detail shell">
    <header class="bside-detail-header">
      <a class="back-link" href="/b-side">
        <span aria-hidden="true">←</span> B—side
      </a>
      <p class="bside-detail-number" aria-hidden="true">
        {displayNumber}
      </p>
      <div class="bside-detail-title">
        <p class="eyebrow">
          {entry.data.category} · {entry.data.year}
        </p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.description}</p>
      </div>
    </header>

    <div class:list={['bside-detail-media', `bside-detail-media--${entry.data.orientation}`]}>
      {entry.data.image ? (
        <img src={entry.data.image} alt={entry.data.imageAlt ?? ''} decoding="async" />
      ) : (
        <span class="bside-placeholder" aria-hidden="true">
          <span>{displayNumber}</span>
          <span>Upload an image in Pages CMS</span>
        </span>
      )}
    </div>

    <div class="bside-detail-body">
      <p class="eyebrow">Notes</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {nextEntry && nextEntry.id !== entry.id && (
    <aside class="next-project shell" aria-label="Next B-side entry">
      <p class="eyebrow">Next on the B—side</p>
      <a href={`/b-side/${nextEntry.id}`}>
        <span>{nextEntry.data.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </aside>
  )}
</BaseLayout>

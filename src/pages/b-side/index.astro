---
import { getCollection, getEntry, render } from 'astro:content';
import BSideCard from '../../components/BSideCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'b-side');
if (!page) throw new Error('Missing src/content/pages/b-side.md');

const { Content } = await render(page);
const entries = (await getCollection('bside', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="bside-hero">
    <div class="bside-hero-inner shell">
      <p class="eyebrow">
        {page.data.eyebrow} · {String(entries.length).padStart(2, '0')} pieces
      </p>
      <h1>{page.data.heroTitle}</h1>
    </div>
  </header>

  <section class="bside-intro shell" aria-label="About the B-side">
    <div class="bside-intro-copy prose-lead">
      <Content />
    </div>
    <p class="bside-intro-note">Experiments, images, and things worth keeping.</p>
  </section>

  <section class="bside-index shell" aria-label="B-side archive">
    {entries.length > 0 ? (
      <div class="bside-grid">
        {entries.map((entry, index) => (
          <BSideCard entry={entry} index={index} />
        ))}
      </div>
    ) : (
      <p class="bside-empty">Add the first entry in Pages CMS.</p>
    )}
  </section>

  <aside class="bside-rail" aria-hidden="true">
    <strong>B.</strong>
    <span>Personal archive</span>
  </aside>
</BaseLayout>

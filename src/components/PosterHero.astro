interface BitmapPixel {
  x: number;
  y: number;
}

const buildBitmap = (value: string) => {
  const pixels: BitmapPixel[] = [];
  let cursor = 0;

  for (const character of value) {
    if (character === ' ') {
      cursor += 4;
      continue;
    }

    const glyph = bitmapGlyphs[character];
    if (!glyph) {
      cursor += 8;
      continue;
    }

    glyph.forEach((row, y) => {
      Array.from(row).forEach((cell, x) => {
        if (cell === '1') pixels.push({ x: cursor + x, y });
      });
    });
    cursor += 8;
  }

  return { pixels, width: Math.max(cursor - 1, 1), height: 11 };
};

const splitBitmapCells = (bitmap: ReturnType<typeof buildBitmap>) => ({
  ...bitmap,
  pixels: bitmap.pixels.flatMap((pixel) => [
    { x: pixel.x, y: pixel.y },
    { x: pixel.x + 0.5, y: pixel.y },
    { x: pixel.x, y: pixel.y + 0.5 },
    { x: pixel.x + 0.5, y: pixel.y + 0.5 },
  ]),
});

const desktopWordmark = splitBitmapCells(buildBitmap(name));
const mobileWordmarks = ['Alex Otake', 'Hsu'].map((word) => splitBitmapCells(buildBitmap(word)));
const wordmarkShardCount = 12;
const splitIntoShards = (pixels: BitmapPixel[]) => {
  const shards = Array.from({ length: wordmarkShardCount }, () => [] as BitmapPixel[]);

  pixels.forEach((pixel) => {
    const column = Math.round(pixel.x * 2);
    const row = Math.round(pixel.y * 2);
    const shardIndex = Math.abs(column * 7 + row * 11) % wordmarkShardCount;
    shards[shardIndex].push(pixel);
  });

  return shards;
};
const desktopWordmarkShards = splitIntoShards(desktopWordmark.pixels);
const mobileWordmarkShards = mobileWordmarks.map((wordmark) => splitIntoShards(wordmark.pixels));
// A slight overlap prevents sub-pixel seams in the solid, unhovered wordmark.
const bitmapCellSize = 0.505;
---

<section class="poster-hero" data-poster-hero aria-labelledby="poster-hero-title">
  <div class="poster-hero-noise" aria-hidden="true"></div>

  <div class="visually-hidden">
    <h1 id="poster-hero-title">{name}</h1>
    <p>
      Curiosity becomes a question and a direction. Ideas take shape as objects, systems, and
      stories. Design and code are a language for making meaning.
    </p>
  </div>

  <p class="poster-side-note" aria-hidden="true">
    NYC / ET
  </p>

  <div class="poster-composition" aria-hidden="true">
    {clusters.map(({ className, lines }, clusterIndex) => (
      <div
        class:list={['poster-cluster', className]}
        data-poster-cluster
        data-depth={clusterIndex + 1}
      >
        <div class="poster-cluster-inner">
          {lines.map((line, lineIndex) => (
            <span style={`--line-index: ${lineIndex}`}>{line}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="poster-meta" aria-hidden="true">
    <span>Thoughtful work</span>
    <b>+</b>
    <span>Evolving ideas</span>
    <b>+</b>
    <span>{location}</span>
  </div>

  <nav class="poster-links" aria-label="Explore the portfolio">
    <a href="/work">
      Work <span aria-hidden="true">↗</span>
    </a>
    <a href="/about">
      About <span aria-hidden="true">↗</span>
    </a>
  </nav>

  <a class="poster-scroll" href="#timeline">
    <span>Explore</span>
    <span aria-hidden="true">↓</span>
  </a>

  <div class="poster-wordmark" aria-hidden="true">
    <svg
      class="poster-wordmark-desktop"
      viewBox={`0 0 ${desktopWordmark.width} ${desktopWordmark.height}`}
      preserveAspectRatio="none"
      role="presentation"
    >
      {desktopWordmarkShards.map((pixels, shardIndex) => (
        <g class="poster-wordmark-shard" data-wordmark-shard data-shard-index={shardIndex}>
          {pixels.map((pixel) => (
            <rect
              x={pixel.x}
              y={pixel.y}
              width={bitmapCellSize}
              height={bitmapCellSize}
              data-cell-x={pixel.x + bitmapCellSize / 2}
              data-cell-y={pixel.y + bitmapCellSize / 2}
            />
          ))}
        </g>
      ))}
    </svg>

    <div class="poster-wordmark-mobile">
      {mobileWordmarks.map((wordmark, wordmarkIndex) => (
        <svg
          viewBox={`0 0 ${wordmark.width} ${wordmark.height}`}
          preserveAspectRatio="none"
          role="presentation"
        >
          {mobileWordmarkShards[wordmarkIndex].map((pixels, shardIndex) => (
            <g class="poster-wordmark-shard" data-wordmark-shard data-shard-index={shardIndex}>
              {pixels.map((pixel) => (
                <rect
                  x={pixel.x}
                  y={pixel.y}
                  width={bitmapCellSize}
                  height={bitmapCellSize}
                  data-cell-x={pixel.x + bitmapCellSize / 2}
                  data-cell-y={pixel.y + bitmapCellSize / 2}
                />
              ))}
            </g>
          ))}
        </svg>
      ))}
    </div>
  </div>
</section>

<script>
  const initializePosterHero = (root: HTMLElement) => {
    if (root.dataset.enhanced === 'true') return;
    root.dataset.enhanced = 'true';

    const clusters = Array.from(root.querySelectorAll<HTMLElement>('[data-poster-cluster]'));
    const wordmark = root.querySelector<HTMLElement>('.poster-wordmark');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    if (clusters.length === 0 || reducedMotion.matches) return;

    const shardDirections = [
      { x: -2.2, y: -13, turn: -0.35 },
      { x: 1.8, y: -17, turn: 0.3 },
      { x: -1.2, y: -11, turn: -0.2 },
      { x: 2.4, y: -15, turn: 0.4 },
      { x: -2.7, y: -18, turn: -0.45 },
      { x: 1.3, y: -12, turn: 0.22 },
      { x: -1.8, y: -16, turn: -0.3 },
      { x: 2.2, y: -11, turn: 0.38 },
      { x: -0.8, y: -19, turn: -0.24 },
      { x: 1.9, y: -14, turn: 0.28 },
      { x: -2.3, y: -17, turn: -0.4 },
      { x: 1, y: -10, turn: 0.32 },
    ];

    const wordmarkShards = wordmark
      ? Array.from(wordmark.querySelectorAll<SVGGElement>('[data-wordmark-shard]')).map(
          (element) => {
            const svg = element.ownerSVGElement;
            const viewBox = svg?.viewBox.baseVal;

            return {
              element,
              index: Number(element.dataset.shardIndex ?? 0),
              centerX: viewBox ? viewBox.x + viewBox.width / 2 : 0,
              centerY: viewBox ? viewBox.y + viewBox.height / 2 : 0,
            };
          },
        )
      : [];

    let scrollFrameId = 0;
    const renderScroll = () => {
      const bounds = root.getBoundingClientRect();
      const scrollRange = Math.max(root.offsetHeight * 0.92, 1);
      const linearProgress = Math.min(Math.max(-bounds.top / scrollRange, 0), 1);
      const progress = linearProgress * linearProgress * (3 - 2 * linearProgress);

      wordmarkShards.forEach(({ element, index, centerX, centerY }) => {
        const direction = shardDirections[index % shardDirections.length];
        const delay = (index % 6) * 0.02;
        const localProgress = Math.min(Math.max((progress - delay) / (1 - delay), 0), 1);
        const easedProgress = localProgress * localProgress * (3 - 2 * localProgress);
        const x = direction.x * easedProgress;
        const y = direction.y * easedProgress;
        const turn = direction.turn * easedProgress;
        const fadeProgress = Math.min(Math.max((localProgress - 0.16) / 0.84, 0), 1);

        element.setAttribute(
          'transform',
          `translate(${x.toFixed(3)} ${y.toFixed(3)}) rotate(${turn.toFixed(3)} ${centerX.toFixed(3)} ${centerY.toFixed(3)})`,
        );
        element.style.opacity = (1 - Math.pow(fadeProgress, 1.35) * 0.94).toFixed(3);
      });

      scrollFrameId = 0;
    };

    const requestScrollRender = () => {
      if (scrollFrameId === 0) scrollFrameId = window.requestAnimationFrame(renderScroll);
    };

    const scrollController = new AbortController();
    window.addEventListener('scroll', requestScrollRender, {
      passive: true,
      signal: scrollController.signal,
    });
    window.addEventListener('resize', requestScrollRender, {
      passive: true,
      signal: scrollController.signal,
    });
    document.addEventListener('astro:before-swap', () => scrollController.abort(), { once: true });
    requestScrollRender();

    let frameId = 0;
    let pointerX = 0;
    let pointerY = 0;

    const render = () => {
      clusters.forEach((cluster, index) => {
        const depth = Number(cluster.dataset.depth ?? index + 1);
        const direction = index % 2 === 0 ? 1 : -1;
        const x = pointerX * depth * 1.6 * direction;
        const y = pointerY * depth * 0.9;
        cluster.style.setProperty('--shift-x', `${x.toFixed(2)}px`);
        cluster.style.setProperty('--shift-y', `${y.toFixed(2)}px`);
      });
      frameId = 0;
    };

    const requestRender = () => {
      if (frameId === 0) frameId = window.requestAnimationFrame(render);
    };

    root.addEventListener('pointermove', (event) => {
      const bounds = root.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left) / bounds.width - 0.5;
      pointerY = (event.clientY - bounds.top) / bounds.height - 0.5;
      requestRender();
    });

    root.addEventListener('pointerleave', () => {
      pointerX = 0;
      pointerY = 0;
      requestRender();
    });

    if (wordmark && finePointer.matches) {
      const wordmarkGroups = Array.from(wordmark.querySelectorAll<SVGSVGElement>('svg')).map(
        (svg) => ({
          svg,
          cells: Array.from(svg.querySelectorAll<SVGRectElement>('rect')).map((element) => ({
            element,
            x: Number(element.dataset.cellX),
            y: Number(element.dataset.cellY),
          })),
        }),
      );
      let wordmarkFrameId = 0;
      let cursorX = 0;
      let cursorY = 0;

      const renderWordmarkLens = () => {
        wordmarkGroups.forEach(({ svg, cells }) => {
          const bounds = svg.getBoundingClientRect();
          const viewBox = svg.viewBox.baseVal;
          if (bounds.width === 0 || bounds.height === 0 || viewBox.width === 0) return;

          const outerRadius = Math.min(300, Math.max(160, bounds.width * 0.14));
          const innerRadius = outerRadius * 0.16;

          cells.forEach((cell) => {
            const cellX = bounds.left + ((cell.x - viewBox.x) / viewBox.width) * bounds.width;
            const cellY = bounds.top + ((cell.y - viewBox.y) / viewBox.height) * bounds.height;
            const distance = Math.hypot(cursorX - cellX, cursorY - cellY);
            const linearInfluence = Math.min(
              Math.max(1 - (distance - innerRadius) / (outerRadius - innerRadius), 0),
              1,
            );
            const influence = linearInfluence * linearInfluence * (3 - 2 * linearInfluence);
            const radius = influence * 0.252;
            const scale = 1 - influence * 0.09;

            cell.element.style.setProperty('--cell-radius', `${radius.toFixed(3)}px`);
            cell.element.style.setProperty('--cell-scale', scale.toFixed(3));
          });
        });
        wordmarkFrameId = 0;
      };

      const requestWordmarkRender = () => {
        if (wordmarkFrameId === 0) {
          wordmarkFrameId = window.requestAnimationFrame(renderWordmarkLens);
        }
      };

      wordmark.addEventListener('pointermove', (event) => {
        cursorX = event.clientX;
        cursorY = event.clientY;
        requestWordmarkRender();
      });

      wordmark.addEventListener('pointerleave', () => {
        wordmarkGroups.forEach(({ cells }) => {
          cells.forEach(({ element }) => {
            element.style.removeProperty('--cell-radius');
            element.style.removeProperty('--cell-scale');
          });
        });
      });
    }
  };

  document.querySelectorAll<HTMLElement>('[data-poster-hero]').forEach(initializePosterHero);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-poster-hero]').forEach(initializePosterHero);
  });
</script>

<style>
  .poster-hero {
    --poster-ink: #0d0d0f;
    position: relative;
    height: 100svh;
    min-height: 42rem;
    overflow: hidden;
    background: #ffffff;
    color: var(--poster-ink);
    isolation: isolate;
  }

  .poster-hero-noise {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.28'/%3E%3C/svg%3E");
    opacity: 0.055;
    pointer-events: none;
  }

  .poster-composition {
    position: absolute;
    inset: 0;
  }

  .poster-cluster {
    --shift-x: 0px;
    --shift-y: 0px;
    position: absolute;
    font-size: clamp(1.55rem, 1.85vw, 2.35rem);
    font-weight: 430;
    letter-spacing: -0.055em;
    line-height: 0.96;
    white-space: nowrap;
    transform: translate3d(var(--shift-x), var(--shift-y), 0);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .poster-cluster-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: poster-drift 9s ease-in-out infinite alternate;
  }

  .poster-cluster span {
    display: block;
    opacity: 0;
    transform: translateY(0.72em);
    animation: poster-line-in 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(180ms + var(--line-index) * 45ms);
  }

  .poster-cluster-curiosity {
    top: 33%;
    left: 23.5%;
  }

  .poster-cluster-ideas {
    top: 42%;
    left: 41%;
  }

  .poster-cluster-ideas .poster-cluster-inner {
    animation-delay: -2s;
  }

  .poster-cluster-language {
    top: 23%;
    left: 60.5%;
  }

  .poster-cluster-language .poster-cluster-inner {
    animation-delay: -4s;
  }

  .poster-cluster-learning {
    top: 39%;
    left: 82.5%;
  }

  .poster-cluster-learning .poster-cluster-inner {
    animation-delay: -6s;
  }

  .poster-side-note,
  .poster-meta,
  .poster-links,
  .poster-scroll {
    position: absolute;
    z-index: 2;
    margin: 0;
    font-size: clamp(0.68rem, 0.72vw, 0.82rem);
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .poster-side-note {
    top: 48%;
    left: clamp(1.25rem, 3vw, 3.5rem);
  }

  .poster-meta {
    right: 25%;
    bottom: clamp(11rem, 27vh, 20rem);
    display: flex;
    gap: clamp(0.8rem, 2.1vw, 2.5rem);
    align-items: center;
    color: rgb(13 13 15 / 62%);
  }

  .poster-meta b {
    color: var(--poster-ink);
    font-weight: 500;
  }

  .poster-links {
    right: clamp(1.25rem, 3vw, 3.5rem);
    bottom: clamp(11rem, 27vh, 20rem);
    display: flex;
    gap: 1.5rem;
  }

  .poster-links a,
  .poster-scroll {
    color: inherit;
    text-decoration: none;
  }

  .poster-links a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .poster-links a span {
    transition: transform 180ms ease;
  }

  .poster-links a:hover span {
    transform: translate(0.15rem, -0.15rem);
  }

  .poster-scroll {
    bottom: clamp(11rem, 27vh, 20rem);
    left: clamp(1.25rem, 3vw, 3.5rem);
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .poster-scroll span:last-child {
    transition: transform 180ms ease;
  }

  .poster-scroll:hover span:last-child {
    transform: translateY(0.2rem);
  }

  .poster-wordmark {
    position: absolute;
    z-index: 5;
    right: clamp(1.25rem, 3vw, 3.5rem);
    bottom: clamp(1.25rem, 2.8vh, 2.5rem);
    left: clamp(1.25rem, 3vw, 3.5rem);
    color: var(--poster-ink);
    animation: poster-wordmark-in 1.1s 480ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .poster-wordmark svg {
    display: block;
    overflow: visible;
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  .poster-wordmark-shard {
    will-change: transform, opacity;
  }

  .poster-wordmark rect {
    rx: var(--cell-radius, 0px);
    ry: var(--cell-radius, 0px);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(var(--cell-scale, 1));
    transition:
      rx 220ms cubic-bezier(0.16, 1, 0.3, 1),
      ry 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .poster-wordmark-desktop {
    width: 100%;
    height: clamp(10rem, 22vh, 18rem);
  }

  .poster-wordmark-mobile {
    display: none;
  }

  @keyframes poster-line-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes poster-drift {
    from {
      transform: translateY(-0.18rem);
    }
    to {
      transform: translateY(0.18rem);
    }
  }

  @keyframes poster-wordmark-in {
    from {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
    }
    to {
      clip-path: inset(0);
      opacity: 1;
    }
  }

  @media (max-width: 56rem) {
    .poster-cluster {
      font-size: clamp(1.35rem, 4.5vw, 2rem);
    }

    .poster-cluster-curiosity {
      top: 30%;
      left: 8%;
    }

    .poster-cluster-ideas {
      top: 44%;
      left: 36%;
    }

    .poster-cluster-language {
      top: 17%;
      left: 52%;
    }

    .poster-cluster-learning {
      top: 40%;
      left: 78%;
    }

    .poster-side-note {
      top: 53%;
    }

    .poster-meta,
    .poster-links,
    .poster-scroll {
      bottom: clamp(9rem, 25vh, 14rem);
    }
  }

  @media (max-width: 38rem) {
    .poster-hero {
      min-height: 44rem;
    }

    .poster-cluster {
      font-size: clamp(1.18rem, 5.7vw, 1.65rem);
      line-height: 0.98;
    }

    .poster-cluster-curiosity {
      top: 28%;
      left: 5%;
    }

    .poster-cluster-ideas {
      top: 42%;
      left: 35%;
    }

    .poster-cluster-language {
      top: 14%;
      left: 48%;
    }

    .poster-cluster-learning {
      top: 54%;
      left: 70%;
    }

    .poster-side-note {
      top: 55%;

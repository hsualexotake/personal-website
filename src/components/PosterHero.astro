---
interface Props {
  name: string;
  location: string;
}

const { name, location } = Astro.props;

const clusters = [
  {
    className: 'poster-cluster-curiosity',
    lines: [
      'Curiosity',
      'Curiosity',
      'Curiosity becomes',
      'Becomes a question',
      'A question',
      'A direction',
    ],
  },
  {
    className: 'poster-cluster-ideas',
    lines: [
      'Ideas',
      'Ideas take',
      'Ideas take shape',
      'Take shape',
      'Shape into',
      'Objects',
      'Systems',
      'Stories',
    ],
  },
  {
    className: 'poster-cluster-language',
    lines: [
      'Design',

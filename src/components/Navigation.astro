---
const pathname = Astro.url.pathname;
const isCurrent = pathname === '/b-side' || pathname.startsWith('/b-side/');
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a href="/b-side" aria-current={isCurrent ? 'page' : undefined}>B—side</a>
  </nav>
</header>

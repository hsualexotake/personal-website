---
import { site } from '../lib/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/b-side', label: 'B—side' },
  { href: '/about', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="appearance-switcher" aria-label="Color theme">
    <span aria-hidden="true">[</span>
    <button type="button" data-theme-option="light" aria-pressed="true">
      Light
    </button>
    <span aria-hidden="true">/</span>
    <button type="button" data-theme-option="dark" aria-pressed="false">
      Dark
    </button>
    <span aria-hidden="true">/</span>
    <a class="home-mark" href="/" aria-label={`${site.displayName}, home`}>
      {site.shortName}
    </a>
    <span aria-hidden="true">]</span>
  </div>

  <p class="site-place">
    <span>{site.location}</span>
    <span aria-hidden="true">·</span>
    <time data-site-time data-timezone={site.timezone}></time>
  </p>

  <nav class="site-nav" aria-label="Primary navigation">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
        {label}
      </a>
    ))}
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]'),
  );

  const setTheme = (theme: 'light' | 'dark', remember = true) => {
    root.dataset.theme = theme;
    themeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === theme));
    });
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#151514' : '#fbfbf8');
    if (remember) localStorage.setItem('theme', theme);
  };

  const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
  setTheme(initialTheme, false);
  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      setTheme(button.dataset.themeOption === 'dark' ? 'dark' : 'light');
    });
  });

  const time = document.querySelector<HTMLTimeElement>('[data-site-time]');
  const updateTime = () => {
    if (!time) return;
    const now = new Date();
    time.dateTime = now.toISOString();
    time.textContent = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: time.dataset.timezone,
    }).format(now);
  };
  updateTime();
  window.setInterval(updateTime, 30_000);
</script>
